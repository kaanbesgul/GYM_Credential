# ============================================================================
#  ÖRNEK DOSYA (DUMMY) - buradaki değerlerin HİÇBİRİ gerçek değildir.
#  Çalışan bir sisteme ait değiller; bu depodaki herkes görebilir.
#
#  Gerçek .env üretmek için:   npm run setup
#  (rastgele ve gizli değerler üretir; .env dosyası git'e eklenmez)
#
#  Bu dosyayı olduğu gibi .env olarak kopyalarsanız sunucu ve kurulum betiği
#  "DUMMY" ile başlayan değerleri görüp çalışmayı REDDEDER.
# ============================================================================

PORT=3000
DB_PATH=data/gym.db

# Oturum anahtarlarını imzalar. Gerçek değer en az 32 rastgele bayt olmalı ve gizli kalmalı.
JWT_SECRET=DUMMY-JWT-SECRET-GERCEK-DEGIL-DEGISTIR-0000000000000000

# Örnek salon sahibi hesabı ("npm run setup" ve "npm run seed:demo" bunu kullanır)
ADMIN_EMAIL=admin@gym.local
ADMIN_PASSWORD=DUMMY-SIFRE-GERCEK-DEGIL
GYM_NAME=Demo Salon

# Örnek kapının kimliği ve anahtarı (gate/config.json içine de aynısı yazılır)
GATE_ID=kapi-1
GATE_KEY=DUMMY-KAPI-ANAHTARI-GERCEK-DEGIL

# İsteğe bağlı ayarlar (varsayılanlar config.js içindedir):
# TRUST_PROXY=true      # Caddy/nginx arkasında
# HSTS=true             # yalnızca HTTPS ile yayındayken
# RATE_LIMIT=off        # yalnızca geliştirmede
# JWT_TTL=14d
# MAX_EXPORT_ROWS=50000
